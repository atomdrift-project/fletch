#!/bin/sh
# Pre-commit gate for fletch. Install with `make install-precommit`.
#
# Refuses the commit unless:
#   1. Cargo.toml has no active local path overrides (a dependency or [patch]
#      entry pointing at a sibling checkout via `path = "../..."`). These build
#      against an unpublished local crate and must never be committed.
#   2. `make lint` passes (clippy with -D warnings).
#   3. `make test` passes.
#
# Bypass intentionally with `git commit --no-verify`.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# 1. Reject uncommented `path = "../..."` overrides in Cargo.toml. fletch
# consumes filefacts from git; a relative path override means an unpublished
# local checkout snuck in.
if grep -nE '^[[:space:]]*[^#].*path[[:space:]]*=[[:space:]]*"\.\.' Cargo.toml; then
	echo "pre-commit: refusing commit — Cargo.toml has a local path override (shown above)." >&2
	echo "Remove it before committing, or bypass with: git commit --no-verify" >&2
	exit 1
fi

echo "pre-commit: running make lint..."
make lint

echo "pre-commit: running make test..."
make test

echo "pre-commit: all checks passed."
